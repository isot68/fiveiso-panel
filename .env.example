PANEL_HOST=127.0.0.1
PANEL_PORT=3030
PANEL_ORIGIN=http://localhost:3030
PANEL_DB=data/fiveiso.sqlite
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3030/api/auth/discord/callback

# Enable only behind local Nginx which overwrites X-Real-IP.
PANEL_TRUST_LOCAL_PROXY=false

# Hostinger verification mail. Keep credentials outside the repository.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Separate machine API from browser Cloudflare challenges.
FIVEISO_RESOURCE_ORIGIN=https://api.fiveiso.com
